{
  "name": "dndrun",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests vite.config.ts",
    "preview": "vite preview",
    "smoke:balance": "tsx tests/balance.mts",
    "test:unit": "tsx tests/engine.mts",
    "test": "npm run test:unit && npm run smoke:balance && npm run smoke:endless",
    "format": "prettier --write src tests vite.config.ts",
    "smoke:endless": "tsx tests/endless.mts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
